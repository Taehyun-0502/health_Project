<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.health.app.member.MemberMapper">

    <!-- 회원 가입 SQL -->
 <insert id="join" parameterType="MemberDTO">
    insert into "h_member" (username, password, name, email, role, gym_id, birth)
    values(#{username}, #{password}, #{name}, #{email, jdbcType=VARCHAR}, #{role}, #{gymId}, #{birth})
    </insert>  


    <!-- 아이디(전화번호) 중복확인 SQL -->
    <select id="idcheck" parameterType="MemberDTO" resultType="MemberDTO">
    select * from "h_member" where username = #{username}
    </select>
</mapper>
