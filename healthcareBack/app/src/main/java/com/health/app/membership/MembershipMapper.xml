<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.health.app.membership.MembershipMapper">

    <!-- receiver_id 기준으로 SIGNED(서명완료)된 본인 계약 리스트 조회 (UserDTO -> ContractDTO 변경) -->
    <select id="list" parameterType="Long" resultType="com.health.app.contract.ContractDTO">
    select * from "h_contract_data" where receiver_id = #{username} and status = 'SIGNED' order by start_date desc
    </select>
    
</mapper>
